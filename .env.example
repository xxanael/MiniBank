# ============================================================
# MiniBank Pro — Configuration Environnementale
# ============================================================

# Port d'écoute du serveur HTTP/REST
PORT=8080

# URL de connexion à la base de données PostgreSQL
# Format : postgresql://<user>:<password>@<host>:<port>/<dbname>
# Si absent ou injoignable, le backend bascule automatiquement en mode persistance mémoire ACID
DATABASE_URL=postgresql://minibank_user:secret_password@postgres:5432/minibank_db

# Paramètres de sécurité (optionnels)
MINIBANK_ENV=production
MINIBANK_LOCKOUT_ATTEMPTS=5
MINIBANK_LOCKOUT_DURATION_MINUTES=15
MINIBANK_DAILY_TRANSFER_LIMIT=1000000
